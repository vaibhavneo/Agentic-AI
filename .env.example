# Copy this file to .env and fill in your key
# DeepSeek API key — get one free at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional fallback (if you have Anthropic)
# ANTHROPIC_API_KEY=sk-ant-...

# SEC EDGAR (free, no key) — REQUIRED for point-in-time fundamentals.
# SEC's fair-access policy rejects any request whose User-Agent lacks a real
# contact email: without this you get a hard 403, not a rate-limit warning.
# Format: Your Name your@email.com
SEC_USER_AGENT=Your Name your@email.com

# Finnhub also serves REAL-TIME quotes once set, and becomes the top-priority
# quote provider. Until then every keyless equity source is Yahoo, so a live
# price can only reach CROSS_PATH corroboration (two code paths, one vendor)
# rather than CROSS_VENDOR. See mas/realtime.py.

# ── Self-improvement loop ──────────────────────────────────────────────────
# Unset (the default) keeps the loop DRY: every 6 hours it attributes matured
# outcomes, proposes a change, verifies it out of sample and records the
# verdict -- but moves nothing. Set to 1 and it APPLIES what it validates.
#
# What it may touch is a declared whitelist in selfimprove/surface.py: core
# pillar weights and the confidence map, per horizon, inside bounds, one
# bounded step per promotion. It cannot touch the risk veto, the action bands,
# the evidence tiers or the asset-class specs.
#
# Every verdict, refusals included, is at /api/selfimprove/proposals, and
# /api/selfimprove/revert rolls any single change back. Deleting the override
# rows restores shipped behaviour exactly -- there is no migration to undo.
# SELFIMPROVE_APPLY=1

# Optional data providers (free keys; each activates automatically when set)
# Tiingo — documented daily bars API, upgrades the price path over yfinance
# TIINGO_API_KEY=...            (free at tiingo.com)
# Finnhub — earnings calendar (dates + consensus EPS)
# FINNHUB_API_KEY=...           (free at finnhub.io)

# OptionsPilot link (optional). Without it the Options section reports that it
# cannot authenticate and the equity decision is unaffected.
# The code is rotated on OptionsPilot with scripts/rotate_access_code.sh; copy
# the CURRENT value here and into this service's Railway variables.
# OPTIONSPILOT_ACCESS_CODE=...
# OPTIONSPILOT_BASE_URL=https://optionspilot-production-ba41.up.railway.app
