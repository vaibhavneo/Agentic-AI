# Copy this file to .env and fill in your key.

# DeepSeek API key — get one free at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_MODEL=deepseek-v4-flash

# Optional fallback provider
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: USDA FoodData Central API key (free at https://fdc.nal.usda.gov/api-key-signup.html)
# Without this, nutrition lookups fall back to manual label entry only.
# USDA_FDC_API_KEY=...

# Local server port
HEALTHPILOT_PORT=3000

# SQLite database file path (defaults to data/healthpilot.db if unset)
# HEALTHPILOT_DB_PATH=data/healthpilot.db

# Flask secret key for session signing — generate a real random value for anything
# beyond local single-user use (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
# HEALTHPILOT_SECRET_KEY=change-me
