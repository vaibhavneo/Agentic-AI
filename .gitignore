# Secrets (never commit)
.env
**/.env

# Raw source material (~1 GB; the distilled indexes the platform uses ARE tracked)
*.pdf
*.epub
/Research Papers - AI Agents/
/Vibe Coding/

# Rebuildable indexes & runtime mirrors (P2: regenerated from files, not source of truth)
*.pkl
learn_agent/data/
**/metrics.jsonl
data/last_self_check.json

# Desktop-library corpora: ~1.2 GB of chunk indexes derived from local books.
# desk-physics/chunks.json alone is 162 MB, past GitHub's 100 MB hard limit.
# Regenerate with corpus_manager.ingest_corpus(<id>) from the source dirs named
# in memory/corpora/registry.json, which IS tracked.
memory/corpora/desk-*/
*.bak-prechunkfix

# Python / OS noise
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.DS_Store
