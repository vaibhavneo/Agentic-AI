# Generated by agent-hosting/deploy.py for stock-desk — do not edit in the Space.
# Hugging Face runs Docker Spaces as uid 1000 and routes to port 7860.
FROM python:3.9-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 PORT=7860 HOME=/home/user
RUN useradd --create-home --uid 1000 user
WORKDIR /app
COPY --chown=user:user requirements.txt .
RUN pip install -r requirements.txt gunicorn "huggingface_hub>=0.24"
COPY --chown=user:user . .
RUN mkdir -p data && chown -R user:user /app
USER user
EXPOSE 7860
ENTRYPOINT ["/bin/sh", "/app/.hosting/entrypoint.sh"]
CMD ["sh", "-c", "exec gunicorn --bind 0.0.0.0:${PORT} --workers 1 --threads 8 --timeout 600 --graceful-timeout 30 web.app:app"]
