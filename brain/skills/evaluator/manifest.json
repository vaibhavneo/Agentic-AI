{
 "id": "evaluator",
 "name": "Evaluator",
 "version": "1.0.0",
 "description": "Deterministic check runner: shell/test commands to pass-fail report with evidence.",
 "purpose": "'Works' is a test result, not a feeling; quality claims without deterministic checks are anecdotes.",
 "tags": [
  "verification",
  "testing"
 ],
 "inputs": {
  "schema_inline": {
   "type": "object",
   "required": [
    "checks"
   ],
   "properties": {
    "checks": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "id",
       "cmd"
      ],
      "properties": {
       "id": {
        "type": "string"
       },
       "cmd": {
        "type": "string"
       }
      }
     }
    },
    "cwd": {
     "type": "string"
    },
    "timeout_s": {
     "type": "integer",
     "default": 120
    }
   },
   "additionalProperties": false
  }
 },
 "outputs": {
  "schema_inline": {
   "type": "object",
   "required": [
    "results",
    "all_pass"
   ],
   "properties": {
    "all_pass": {
     "type": "boolean"
    },
    "results": {
     "type": "array"
    }
   }
  }
 },
 "memory": {
  "root_param": null,
  "read": [],
  "write": [],
  "append_only": [],
  "immutable": []
 },
 "execution": {
  "contract": "skill.md",
  "steps": [
   "RUN_CHECKS",
   "COLLECT",
   "VERDICT"
  ],
  "runtime": {
   "type": "python",
   "entrypoint": "aios_core.runtime.drivers.library_drivers:run_evaluator"
  }
 },
 "dependencies": [],
 "evaluation": {
  "contract": "skill.md",
  "must": []
 }
}