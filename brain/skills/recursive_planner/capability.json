{
  "name": "recursive_planner",
  "version": "1.0.0",
  "execution": {
    "preferred_models": ["claude-opus", "claude-sonnet", "gpt-5", "gemini"],
    "reasoning_level": "high",
    "estimated_tokens": 8000
  },
  "inputs": ["mission", "memory", "context"],
  "outputs": ["plan", "artifacts", "updated_memory"],
  "quality_requirements": {
    "min_test_coverage": 90,
    "deterministic": true,
    "requires_human_approval": false,
    "coverage_target": "aios_core.runtime.drivers.recursive_planner_driver",
    "coverage_command": "python3 brain/tests/test_runtime.py"
  }
}
