{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "recursive_planner invocation",
  "type": "object",
  "required": ["goal", "memory_root", "stability_criteria"],
  "additionalProperties": false,
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 10,
      "description": "One-sentence falsifiable objective with an observable end state."
    },
    "memory_root": {
      "type": "string",
      "description": "Directory path for memory files. Created if absent."
    },
    "stability_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "check"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "check": {
            "type": "string",
            "description": "Shell command or file-inspection rule that exits 0 / evaluates true when the criterion holds. Must be deterministic."
          }
        }
      }
    },
    "knowledge_sources": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Directories or files to ingest into the retrieval index.",
      "default": []
    },
    "max_cycles": { "type": "integer", "minimum": 1, "default": 25 },
    "plan_depth_limit": { "type": "integer", "minimum": 1, "maximum": 5, "default": 3 },
    "effort": { "enum": ["low", "medium", "high"], "default": "high" }
  }
}
