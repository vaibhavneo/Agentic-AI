{
  "name": "teacher",
  "version": "1.0.0",
  "execution": {
    "preferred_models": ["claude-opus", "claude-sonnet", "gpt-5", "gemini"],
    "reasoning_level": "high",
    "estimated_tokens": 3000
  },
  "inputs": ["topic", "mastery", "mission_context", "retrieved_sources"],
  "outputs": ["explanation", "source_evidence", "exercise", "mastery_check", "recommended_next_action", "concept_candidate"],
  "quality_requirements": {
    "min_test_coverage": 80,
    "deterministic": false,
    "requires_human_approval": false,
    "coverage_target": "aios_core.runtime.drivers.teacher_driver",
    "coverage_command": "python3 brain/skills/teacher/tests/test_skill.py"
  }
}
